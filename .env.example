# Copy to .env.local for your own computer. On Vercel, add these under Settings → Environment Variables.
# Without Stripe keys on your own computer, "Pay" skips payment so you can try the whole flow.

# ---- Address ----
APP_URL="https://reviews.myqr.co.nz"
BRAND_NAME="myQR"
PRODUCT_NAME="Review QR"
SUPPORT_EMAIL="adminmyqr@gmail.com"

# ---- Price (cents, NZD). 599 = $5.99 ----
PRICE_CENTS="599"

# ---- Database (Neon; the same database as the other myQR apps is fine: tables start with rq_) ----
# Leave empty on your own computer: orders are then saved in .data/orders.json
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# ---- Stripe ----
STRIPE_SECRET_KEY="rk_live_..."          # restricted key named "Review QR"
STRIPE_WEBHOOK_SECRET="whsec_..."        # this app's own webhook endpoint
# Optional: a catalogue price instead of the price above (it must be NZD)
STRIPE_PRICE_ID=""

# ---- Email (resend.com). Without a key, emails are printed to the server log ----
RESEND_API_KEY=""
FROM_EMAIL="Review QR <hello@myqr.co.nz>"

# ---- Admin connection (Admin → Products → Review QR) ----
HQ_URL="https://admin.myqr.co.nz"
HQ_PRODUCT="reviews"
HQ_SECRET=""

# ---- Cron (any long random string; Vercel sends it to /api/cron/prune) ----
CRON_SECRET=""

# ---- Optional: "Find your business" search on the order form ----
# Google Cloud → enable "Places API (New)" → API key restricted to that API. Leave empty to hide the search.
GOOGLE_PLACES_API_KEY=""
